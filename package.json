{
    "name": "finscope",
    "version": "0.0.0",
    "private": true,
    "description": "Frontend quality checks for FinScope static assets.",
    "engines": {
        "node": ">=20"
    },
    "scripts": {
        "format:frontend": "prettier --write \"src/finance_app/static/**/*.{css,js}\" \"tests/frontend/**/*.js\"",
        "format:frontend:check": "prettier --check \"src/finance_app/static/**/*.{css,js}\" \"tests/frontend/**/*.js\"",
        "lint:frontend:css": "stylelint \"src/finance_app/static/css/**/*.css\"",
        "lint:frontend:js": "eslint \"src/finance_app/static/js/**/*.js\" \"tests/frontend/**/*.js\"",
        "test:frontend": "vitest run tests/frontend",
        "lint:frontend": "npm run format:frontend:check && npm run lint:frontend:js && npm run lint:frontend:css && npm run test:frontend"
    },
    "devDependencies": {
        "@eslint/js": "^9.0.0",
        "eslint": "^9.0.0",
        "globals": "^16.0.0",
        "jsdom": "^30.0.1",
        "prettier": "3.8.4",
        "stylelint": "^16.0.0",
        "stylelint-config-recommended": "^16.0.0",
        "vitest": "^5.0.1"
    }
}
