flowchart TB

    browser["🌐 Browser"]

    subgraph app["Flask application"]
        direction TB

        flask["Flask app factory<br/><b>finance_app.create_app()</b>"]

        subgraph features["Feature modules"]
            direction TB
            blueprints["Blueprint registration"]
            controllers["Controllers<br/>HTTP routes"]
            logic["Logic layer<br/>services • workflows • forms<br/>presenters • engines"]
            persistence["Persistence layer<br/>repositories • queries<br/>schema • connections"]
        end

        subgraph platform["Core platform services"]
            direction LR
            core["Configuration<br/>CSRF • filters • i18n"]
            background["Background jobs"]
        end
    end

    subgraph frontend["Presentation layer"]
        direction TB
        templates["Jinja templates"]
        static["Static assets<br/>CSS • JavaScript • images"]
        translations["Translation catalogs<br/>translations/*.json"]
    end

    sqlite[("SQLite database<br/>runtime/finance.db")]
    openai["OpenAI API<br/><i>optional</i>"]

    browser --> flask

    flask --> blueprints
    flask --> core

    blueprints --> controllers
    controllers --> logic
    controllers --> templates

    logic --> persistence
    logic --> background
    logic -. optional .-> openai

    persistence --> sqlite

    templates --> static
    templates --> translations

