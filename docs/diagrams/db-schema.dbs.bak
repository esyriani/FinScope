		<table name="category_rules" spec="" >
			<column name="id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="merchant_id" type="INTEGER" />
			<column name="keyword" type="TEXT" mandatory="y" />
			<column name="category" type="TEXT" />
			<column name="category_id" type="INTEGER" />
			<column name="amount_min" type="REAL" />
			<column name="amount_max" type="REAL" />
			<column name="source" type="TEXT" mandatory="y" >
				<defo><![CDATA['manual']]></defo>
			</column>
			<column name="created_at" type="TEXT" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<column name="ai_approved" type="INTEGER" mandatory="y" >
				<defo><![CDATA[0]]></defo>
			</column>
			<column name="IFNULL(amount_min, -999999999999.0)" type="TEXT" spec="functional" />
			<column name="IFNULL(amount_max, -999999999999.0)" type="TEXT" spec="functional" />
			<column name="IFNULL(amount_min, -999999999999.0)" type="TEXT" spec="functional" />
			<column name="IFNULL(amount_max, -999999999999.0)" type="TEXT" spec="functional" />
			<index name="pk_category_rules" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="idx_category_rules_keyword" unique="NORMAL" >
				<column name="keyword" />
			</index>
			<index name="idx_category_rules_merchant" unique="NORMAL" >
				<column name="merchant_id" />
			</index>
			<index name="idx_category_rules_category_id" unique="NORMAL" >
				<column name="category_id" />
			</index>
			<index name="idx_category_rules_keyword_amount_unique" unique="UNIQUE_INDEX" options="WHERE merchant_id IS NULL" >
				<column name="keyword" />
				<column name="IFNULL(amount_min, -999999999999.0)" />
				<column name="IFNULL(amount_max, -999999999999.0)" />
			</index>
			<index name="idx_category_rules_merchant_amount_unique" unique="UNIQUE_INDEX" options="WHERE merchant_id IS NOT NULL" >
				<column name="merchant_id" />
				<column name="IFNULL(amount_min, -999999999999.0)" />
				<column name="IFNULL(amount_max, -999999999999.0)" />
			</index>
			<index name="idx_category_rules_source_approval" unique="NORMAL" >
				<column name="source" />
				<column name="ai_approved" />
			</index>
			<constraint name="CK_category_rules" type="CHECK" options="" >
				<string><![CDATA[TRIM(keyword) <> '']]></string>
			</constraint>
			<constraint name="CK_category_rules_001" type="CHECK" options="" >
				<string><![CDATA[source IN ('automatic', 'default', 'manual')]]></string>
			</constraint>
			<constraint name="CK_category_rules_002" type="CHECK" options="" >
				<string><![CDATA[amount_min IS NULL OR amount_max IS NULL OR amount_min <= amount_max]]></string>
			</constraint>
			<fk name="FK_category_rules merchants" to_schema="Default" to_table="merchants" delete_action="setNull" >
				<fk_column name="merchant_id" pk="id" />
			</fk>
			<fk name="FK_category_rules categories" to_schema="Default" to_table="categories" delete_action="setNull" >
				<fk_column name="category_id" pk="id" />
			</fk>
		</table>
