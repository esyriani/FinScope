		<table name="recurring_patterns" spec="" >
			<column name="pattern_key" type="TEXT" mandatory="y" />
			<column name="merchant_id" type="INTEGER" />
			<column name="merchant" type="TEXT" mandatory="y" />
			<column name="type" type="TEXT" mandatory="y" />
			<column name="user_status" type="TEXT" mandatory="y" >
				<defo><![CDATA['detected']]></defo>
			</column>
			<column name="frequency" type="TEXT" />
			<column name="expected_day" type="INTEGER" />
			<column name="typical_amount" type="REAL" />
			<column name="date_tolerance_days" type="INTEGER" />
			<column name="amount_tolerance" type="REAL" />
			<column name="active" type="INTEGER" mandatory="y" >
				<defo><![CDATA[1]]></defo>
			</column>
			<column name="created_at" type="TEXT" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<column name="updated_at" type="TEXT" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<index name="pk_recurring_patterns" unique="PRIMARY_KEY" >
				<column name="pattern_key" />
			</index>
			<index name="idx_recurring_patterns_status" unique="NORMAL" >
				<column name="user_status" />
				<column name="active" />
			</index>
			<index name="idx_recurring_patterns_merchant_type" unique="UNIQUE_INDEX" options="WHERE merchant_id IS NOT NULL" >
				<column name="merchant_id" />
				<column name="type" />
			</index>
			<constraint name="CK_recurring_patterns" type="CHECK" options="" >
				<string><![CDATA[type IN ('income', 'spending')]]></string>
			</constraint>
			<constraint name="CK_recurring_patterns_001" type="CHECK" options="" >
				<string><![CDATA[user_status IN ('confirmed', 'detected', 'edited', 'ignored')]]></string>
			</constraint>
			<constraint name="CK_recurring_patterns_002" type="CHECK" options="" >
				<string><![CDATA[active IN (0, 1)]]></string>
			</constraint>
			<constraint name="CK_recurring_patterns_003" type="CHECK" options="" >
				<string><![CDATA[expected_day IS NULL OR (expected_day >= 1 AND expected_day <= 31)]]></string>
			</constraint>
			<constraint name="CK_recurring_patterns_004" type="CHECK" options="" >
				<string><![CDATA[date_tolerance_days IS NULL OR date_tolerance_days >= 0]]></string>
			</constraint>
			<constraint name="CK_recurring_patterns_005" type="CHECK" options="" >
				<string><![CDATA[amount_tolerance IS NULL OR amount_tolerance >= 0]]></string>
			</constraint>
			<constraint name="CK_recurring_patterns_006" type="CHECK" options="" >
				<string><![CDATA[typical_amount IS NULL OR typical_amount >= 0]]></string>
			</constraint>
			<fk name="FK_recurring_patterns merchants" to_schema="Default" to_table="merchants" delete_action="setNull" >
				<fk_column name="merchant_id" pk="id" />
			</fk>
