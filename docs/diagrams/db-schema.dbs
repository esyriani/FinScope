		<table name="category_rules" spec="" >
			<column name="id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="account_id" type="INTEGER" />
			<column name="merchant_id" type="INTEGER" />
			<column name="keyword" type="TEXT" mandatory="y" />
			<column name="category" type="TEXT" />
			<column name="category_id" type="INTEGER" />
			<column name="amount_min" type="NUMERIC" length="14" decimal="2" />
			<column name="amount_max" type="NUMERIC" length="14" decimal="2" />
			<column name="direction" type="TEXT" length="16" mandatory="y" >
				<defo><![CDATA['any']]></defo>
			</column>
			<column name="keyword_scope_key" type="TEXT" length="255" >
				<identity><![CDATA[GENERATED  ALWAYS AS (CASE WHEN merchant_id IS NULL THEN keyword ELSE NULL END)]]></identity>
			</column>
			<column name="account_id_key" type="INTEGER" >
				<identity><![CDATA[GENERATED  ALWAYS AS (COALESCE(account_id, -1))]]></identity>
			</column>
			<column name="amount_min_key" type="NUMERIC" length="14" decimal="2" >
				<identity><![CDATA[GENERATED  ALWAYS AS (COALESCE(amount_min, -999999999999.00))]]></identity>
			</column>
			<column name="amount_max_key" type="NUMERIC" length="14" decimal="2" >
				<identity><![CDATA[GENERATED  ALWAYS AS (COALESCE(amount_max, -999999999999.00))]]></identity>
			</column>
			<column name="source" type="TEXT" mandatory="y" >
				<defo><![CDATA['manual']]></defo>
			</column>
			<column name="created_at" type="TEXT" mandatory="y" >
				<defo><![CDATA[CURRENT_TIMESTAMP]]></defo>
			</column>
			<column name="ai_approved" type="INTEGER" mandatory="y" >
				<defo><![CDATA[0]]></defo>
			</column>
			<column name="IFNULL(amount_min, -999999999999.0)" type="TEXT" spec="functional" />
			<column name="IFNULL(amount_max, -999999999999.0)" type="TEXT" spec="functional" />
			<column name="IFNULL(amount_min, -999999999999.0)" type="TEXT" spec="functional" />
			<column name="IFNULL(amount_max, -999999999999.0)" type="TEXT" spec="functional" />
			<index name="pk_category_rules" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="idx_category_rules_keyword" unique="NORMAL" >
				<column name="keyword" />
			</index>
			<index name="idx_category_rules_merchant" unique="NORMAL" >
				<column name="merchant_id" />
			</index>
			<index name="idx_category_rules_category_id" unique="NORMAL" >
				<column name="category_id" />
			</index>
			<index name="idx_category_rules_source_approval" unique="NORMAL" >
				<column name="source" />
				<column name="ai_approved" />
			</index>
			<index name="uq_category_rules_keyword_amount" unique="UNIQUE_KEY" >
				<column name="keyword_scope_key" />
				<column name="account_id_key" />
				<column name="direction" />
				<column name="amount_min_key" />
				<column name="amount_max_key" />
			</index>
			<index name="uq_category_rules_merchant_amount" unique="UNIQUE_KEY" >
				<column name="merchant_id" />
				<column name="account_id_key" />
				<column name="direction" />
				<column name="amount_min_key" />
				<column name="amount_max_key" />
			</index>
			<index name="idx_category_rules_account" unique="NORMAL" >
				<column name="account_id" />
			</index>
			<index name="idx_category_rules_direction" unique="NORMAL" >
				<column name="direction" />
			</index>
			<index name="idx_category_rules_amount_bounds" unique="NORMAL" >
				<column name="amount_min" />
				<column name="amount_max" />
			</index>
			<constraint name="ck_category_rules_category_rules_source_allowed" type="CHECK" options="" >
				<string><![CDATA[source IN ('automatic', 'manual')]]></string>
			</constraint>
			<constraint name="ck_category_rules_category_rules_ai_approved_bool" type="CHECK" options="" >
				<string><![CDATA[ai_approved IN (0, 1)]]></string>
			</constraint>
			<constraint name="ck_category_rules_category_rules_amount_range_order" type="CHECK" options="" >
				<string><![CDATA[amount_min IS NULL OR amount_max IS NULL OR amount_min <= amount_max]]></string>
			</constraint>
			<constraint name="ck_category_rules_category_rules_keyword_non_empty" type="CHECK" options="" >
				<string><![CDATA[trim(keyword) != '']]></string>
			</constraint>
			<constraint name="ck_category_rules_category_rules_direction_allowed" type="CHECK" options="" >
				<string><![CDATA[direction IN ('any', 'credit', 'debit')]]></string>
			</constraint>
			<fk name="FK_category_rules merchants" to_schema="Default" to_table="merchants" delete_action="setNull" >
				<fk_column name="merchant_id" pk="id" />
			</fk>
			<fk name="FK_category_rules categories" to_schema="Default" to_table="categories" delete_action="setNull" >
				<fk_column name="category_id" pk="id" />
			</fk>
			<fk name="fk_category_rules_account_id_accounts" to_schema="Default" to_table="accounts" delete_action="setNull" options="" >
				<fk_column name="account_id" pk="id" />
			</fk>
		</table>
