<?xml version="1.0" encoding="UTF-8" ?>
<project name="Sqlite" database="Sqlite" id="6888e5d5-d090-450d-a64e-33a401e7778b" >
	<schema name="Default" >
		<table name="accounts" spec="" >
			<column name="id" type="INTEGER" mandatory="y" >
				<identity><![CDATA[AUTOINCREMENT]]></identity>
			</column>
			<column name="name" type="TEXT" mandatory="y" />
			<column name="name_key" type="TEXT" length="255" >
				<identity><![CDATA[GENERATED  ALWAYS AS (lower(trim(name)))]]></identity>
			</column>
			<column name="account_type" type="TEXT" mandatory="y" >
				<defo><![CDATA['checking']]></defo>
			</column>
			<column name="paid_from_account_id" type="INTEGER" />
			<index name="pk_accounts" unique="PRIMARY_KEY" >
				<column name="id" />
			</index>
			<index name="uq_accounts_name_key" unique="UNIQUE_KEY" >
				<column name="name_key" />
			</index>
			<constraint name="ck_accounts_accounts_account_type_allowed" type="CHECK" options="" >
				<string><![CDATA[account_type IN ('checking', 'credit_card', 'savings')]]></string>
			</constraint>
			<constraint name="ck_accounts_accounts_name_non_empty" type="CHECK" options="" >
				<string><![CDATA[trim(name) != '']]></string>
			</constraint>
			<fk name="FK_accounts accounts" to_schema="Default" to_table="accounts" delete_action="setNull" >
				<fk_column name="paid_from_account_id" pk="id" />
			</fk>
		</table>
		<table name="audit_log" spec="" >
